# Server-only configuration. The service-role key must never be exposed to the browser.
NODE_ENV=development
PORT=4000
CLIENT_ORIGINS=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=kongu.edu
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# demo stores a clearly identified simulation; razorpay_test only accepts an rzp_test_ key.
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=rzp_test_your-test-key-id
RAZORPAY_KEY_SECRET=your-server-only-test-key-secret
RAZORPAY_WEBHOOK_SECRET=your-server-only-test-webhook-secret
# Leave blank to keep the overdue endpoint disabled; configure a generated secret before scheduling it.
CRON_SECRET=
OVERDUE_GRACE_DAYS=1
